# Échelle horizontale de la courbe normale
dens_scaled <- dens / max(dens) * 0.8
# --------------------------------------------------
# Graphique
# --------------------------------------------------
ggplot(crabs, aes(FL, CL)) +
# Données
geom_point(
color = "grey70",
alpha = 0.5,
size = 3
) +
# Segments min-max pour chaque FL entier
geom_segment(
data = dispersion,
aes(
x = FL_int,
xend = FL_int,
y = Y_min,
yend = Y_max
),
color = "#7B3294",
linetype = "dashed",
linewidth = 1.1
) +
# Observations autour de x0
geom_point(
data = data_focus,
color = "#0072B2",
size = 5
) +
# Droite de régression
geom_smooth(
method = "lm",
se = FALSE,
color = "#E69F00",
linewidth = 2
) +
# Moyenne des observations autour de x0
geom_point(
aes(x = x0, y = mean_y),
color = "#7B3294",
size = 7
) +
# Valeur prédite par la droite
geom_point(
aes(x = x0, y = y_hat),
color = "#E69F00",
size = 5
) +
# Écart entre moyenne observée et valeur prédite
geom_segment(
aes(
x = x0,
xend = x0,
y = mean_y,
yend = y_hat
),
color = "#7B3294",
linetype = "dashed",
linewidth = 1
) +
# Courbe normale
geom_line(
data = data.frame(
x = x0 + dens_scaled,
y = y_norm
),
aes(x = x, y = y),
color = "#7B3294",
linewidth = 1.5
) +
labs(
title = "Hypothèses de la régression linéaire",
x = "FL = longueur du lobe frontal",
y = "CL = longueur de la carapace"
) +
theme_minimal(base_size = 20) +
theme(
plot.title = element_text(
size = 28,
face = "bold",
hjust = 0.5
),
axis.title = element_text(size = 24),
axis.text = element_text(size = 20)
)
#| echo: false
#| message: false
#| warning: false
#| fig-height: 5
# --------------------------------------------------
# Régression linéaire
# --------------------------------------------------
mod <- lm(CL ~ FL, data = crabs)
# --------------------------------------------------
# Segments min-max pour chaque valeur entière de FL
# --------------------------------------------------
dispersion <- crabs %>%
mutate(FL_int = round(FL)) %>%
group_by(FL_int) %>%
summarise(
Y_min = min(CL),
Y_max = max(CL),
.groups = "drop"
)
# --------------------------------------------------
# Zone mise en évidence autour de x0
# --------------------------------------------------
x0 <- 15
delta <- 0.5
data_focus <- crabs %>%
filter(
FL >= x0 - delta,
FL <= x0 + delta
)
# Moyenne observée
mean_y <- mean(data_focus$CL)
# Valeur prédite par la droite
y_hat <- predict(
mod,
newdata = data.frame(FL = x0)
)
# --------------------------------------------------
# Densité normale autour de la moyenne prédite
# --------------------------------------------------
residus <- data_focus$CL -
predict(mod, newdata = data_focus)
sigma <- sd(residus)
y_norm <- seq(
y_hat - 4 * sigma,
y_hat + 4 * sigma,
length.out = 300
)
dens <- dnorm(
y_norm,
mean = y_hat,
sd = sigma
)
# Mise à l'échelle horizontale de la densité
dens_scaled <- dens / max(dens) * 1.2
dens_data <- data.frame(
FL = x0 + dens_scaled,
CL = y_norm
)
# --------------------------------------------------
# Graphique
# --------------------------------------------------
ggplot(crabs, aes(FL, CL)) +
# Observations
geom_point(
color = "grey70",
alpha = 0.5,
size = 4
) +
# Dispersion min-max pour chaque valeur entière de FL
geom_segment(
data = dispersion,
aes(
x = FL_int,
xend = FL_int,
y = Y_min,
yend = Y_max
),
color = "#7B3294",
linetype = "dashed",
linewidth = 1.3
) +
# Observations autour de x0
geom_point(
data = data_focus,
color = "#0072B2",
size = 6
) +
# Droite de régression
geom_smooth(
method = "lm",
se = FALSE,
color = "#E69F00",
linewidth = 2.5
) +
# Moyenne observée : croix noire
geom_point(
aes(x = x0, y = mean_y),
shape = 4,
color = "black",
size = 7,
stroke = 2
) +
# Valeur prédite sur la droite
geom_point(
aes(x = x0, y = y_hat),
color = "#E69F00",
size = 6
) +
# Écart entre moyenne observée et valeur prédite
geom_segment(
aes(
x = x0,
xend = x0,
y = mean_y,
yend = y_hat
),
color = "black",
linetype = "dashed",
linewidth = 1.2
) +
# Courbe de densité normale : contour uniquement
geom_line(
data = dens_data,
aes(x = FL, y = CL),
color = "black",
linewidth = 2
) +
labs(
x = "FL",
y = "CL"
) +
theme_minimal(base_size = 22) +
theme(
axis.title = element_text(size = 26),
axis.text = element_text(size = 22)
)
mean(crabs$CL)
mean(crabs$FL)
sum(crabs$FL - mean(crabs$FL))
x <- crabs$FL - mean(crabs$FL)
x
sum(x)
y <- (crabs$CL - mean(crabs$CL))
x*y
sum(x*y)
sum(x^2)
sum(x*x)
sum(x*y)/sum(x*x)
1.993622 * 15.583
32.106 - 31.06661
9.97/5
mod <- lm(CL ~ FL, data = crabs)
y <- crabs$CL
y_hat <- predict(mod)
y_bar <- mean(y)
# Somme des carrés des résidus
SCR <- sum((y - y_hat)^2)
# Somme des carrés totale
SCT <- sum((y - y_bar)^2)
SCR
SCT
1 - (SCR/SCT)
library(ggplot2)
library(plotly)
library(dplyr)
library(msos)
library(patchwork)
#| echo: false
#| message: false
#| warning: false
#| fig-height: 6
mod <- lm(CL ~ FL, data = crabs)
R2 <- round(summary(mod)$r.squared, 3)
ggplot(crabs, aes(x = FL, y = CL)) +
geom_point(
size = 4,
color = "#0072B2",
alpha = 0.6
) +
geom_smooth(
method = "lm",
se = FALSE,
color = "#E69F00",
linewidth = 2
) +
labs(
title = bquote(R^2 == .(R2)),
x = "FL",
y = "CL"
) +
theme_minimal(base_size = 20) +
theme(
plot.title = element_text(
size = 28,
face = "bold",
hjust = 0.5
),
axis.title = element_text(size = 24),
axis.text = element_text(size = 20)
)
